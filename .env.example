# ============================================================================
# FranzPLAY - Variabili d'ambiente (copia in .env e modifica)
# ============================================================================

# --- Credenziali Database MariaDB ---
MYSQL_ROOT_PASSWORD=la_tua_password_root
MYSQL_DATABASE=FranzPLAY_DBMS
MYSQL_USER=tuo_username
MYSQL_PASSWORD=tua_password

# --- Cache Redis ---
# Lascia vuoto per disabilitare l'auth (Redis comunque NON è esposto fuori dalla rete docker).
# Imposta una password robusta in produzione.
REDIS_PASSWORD=

# --- Percorsi ---
# Cartella reale del server dove sono presenti i video.
PERCORSO_VIDEO="./testVideo"

# --- Deploy / Naming container (opzionale) ---
# Prefisso applicato al nome di TUTTI i container (default vuoto = nomi standard).
# Utile per far convivere più stack sulla stessa macchina. Es. ZimaBlade: FS_
# CONTAINER_PREFIX=
# Porte pubblicate da nginx (default 80/443). Cambiale se le standard sono occupate.
# Es. ZimaBlade dietro reverse proxy: NGINX_HTTP_PORT=8090
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# Immagine PhpMyAdmin: su host x86 usa la multi-arch ufficiale.
# Default (Raspberry/ARM64): arm64v8/phpmyadmin:latest
# PHPMYADMIN_IMAGE=phpmyadmin/phpmyadmin:latest

# --- Tuning Python workers (opzionale) ---
# WATCHER_POLL_TIMEOUT=5
# WORKER_POLL_INTERVAL=10
# WORKER_BACKOFF_MAX=15           # tetto attesa idle worker meta/assets (reattività)
# SUBTITLES_POLL_INTERVAL=10
# SUBTITLES_BACKOFF_MAX=10        # worker sottotitoli on-demand: poll frequente
# FFMPEG_PRESET=ultrafast      # ultrafast/superfast/veryfast/fast/medium
# FFMPEG_COVER_TIMEOUT=20
# FFMPEG_PREVIEW_TIMEOUT=60

# --- Tuning Worker Optimizer (remux fMP4 faststart) ---
# Intervallo base di polling DB; backoff esponenziale fino a OPTIMIZER_BACKOFF_MAX.
# OPTIMIZER_POLL_INTERVAL=30
# OPTIMIZER_BACKOFF_MAX=300
# Ore di grazia prima di cancellare l'originale dopo il remux (failsafe).
# OPTIMIZER_CLEANUP_HOURS=24
# Cap timeout ffmpeg per remux (1800s = 30min, copre 8GB 4K HEVC su SD card).
# OPTIMIZER_REMUX_TIMEOUT=1800
# OPTIMIZER_AUDIO_TIMEOUT=600

# --- Tuning Worker Copertine Online (ricerca su database esterni) ---
# ATTENZIONE: il TOKEN del provider NON si mette qui. Si configura da
# Admin > Copertine e viene salvato in Impostazioni.tpdb_api_token, cosi' e'
# modificabile senza riavviare i container. Queste variabili regolano solo il
# comportamento tecnico del worker.
# COVERS_POLL_INTERVAL=20
# COVERS_BACKOFF_MAX=300
# COVERS_HTTP_TIMEOUT=20
# Dimensione massima di un'immagine scaricata (8 MB). Guardia anti-abuso.
# COVERS_MAX_IMAGE_BYTES=8388608
# COVERS_STALE_LOCK_MINUTES=15
# Quanti video accodare per giro in modalita' automatica.
# COVERS_DISCOVERY_BATCH=50
# Pausa forzata dopo un 429/503 del provider (secondi).
# COVERS_RATE_LIMIT_COOLDOWN=900

# --- Backoff dei tentativi falliti (worker copertine) ---
# Primo ritardo prima di un nuovo tentativo, e tetto massimo. Il backoff
# raddoppia a ogni tentativo: 60s, 120s, 240s... Senza, un problema di rete di
# pochi secondi consumava tutti i tentativi e il job finiva in errore definitivo.
# COVERS_RETRY_BASE=60
# COVERS_RETRY_MAX=3600

# --- Resilienza sessioni PHP quando Redis non risponde ---
# Se Redis e' irraggiungibile le sessioni ripiegano su file qui dentro, invece
# di far fallire l'intera API (prima il sito moriva del tutto). Normalmente non
# serve toccare queste variabili.
# SESSION_FALLBACK_DIR=/App_Data/Sessions
#
# Timeout del controllo di raggiungibilita' di Redis, in secondi.
# REDIS_SESSION_PROBE_TIMEOUT=0.3
#
# Per quanti secondi ricordare che Redis e' giu' senza riprovare a contattarlo.
# ⚠️ MISURATO: con il container Redis fermo, una connessione impiega ~4 secondi
# (il timeout limita il TCP, non la risoluzione del nome). Senza questa memoria
# OGNI richiesta pagava 4 secondi. Con TTL 10s, solo una richiesta ogni 10s li
# paga: le altre rispondono in millisecondi.
# REDIS_DOWN_TTL=10
